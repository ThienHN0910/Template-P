PROJECT_NAME=app

# Database Configuration
# Supported providers: postgresql, mysql, sqlserver, sqlite, mongodb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=<db_password>

# PostgreSQL: Host=localhost;Port=5432;Database=appdb;Username=postgres;Password=<db_password>
# MySQL: Server=localhost;Port=3306;Database=appdb;User=root;Password=<db_password>;
# SQL Server: Server=localhost,1433;Database=appdb;User Id=sa;Password=<db_password>;TrustServerCertificate=True;
# SQLite: Data Source=app.db
# MongoDB: mongodb://root:<db_password>@localhost:27017/appdb?authSource=admin
CONNECTION_STRING=Host=localhost;Port=5432;Database=appdb;Username=postgres;Password=<db_password>
