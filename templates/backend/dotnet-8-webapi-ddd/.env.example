# .NET 8 Web API Environment Variables
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5050

# Database Provider: postgres | mysql | sqlite
DATABASE_PROVIDER=postgres

# Database Connection String
# PostgreSQL: Host=localhost;Port=5432;Database=myapp_db;Username=postgres;Password=postgres
# MySQL: Server=localhost;Port=3306;Database=myapp_db;User=root;Password=root;
# SQLite: Data Source=app.db
CONNECTION_STRING=Host=localhost;Port=5432;Database=myapp_db;Username=postgres;Password=postgres
