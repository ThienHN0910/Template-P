{
  "name": "@thienhn/create-template",
  "version": "1.0.0",
  "description": "Interactive CLI Scaffolder for Universal Fullstack Projects with AI Agent Skills",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-template": "./bin/create-template.js",
    "create-p-stack": "./bin/create-template.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-templates.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "create-app",
    "scaffolder",
    "fullstack",
    "template",
    "dotnet",
    "vue",
    "react",
    "fastapi",
    "agent-skills",
    "mcp"
  ],
  "author": "ThienHN0910",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThienHN0910/Template-P.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ThienHN0910/Template-P#readme",
  "bugs": {
    "url": "https://github.com/ThienHN0910/Template-P/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^15.0.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.5.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
